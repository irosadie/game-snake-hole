package com.example.geckoout.domain

enum class GeckoColor(val bodyHex: Long, val spotHex: Long, val holeRimHex: Long) {
    PURPLE(0xFFB974F8, 0xFFDFB6FF, 0xFFC989FF),
    ORANGE(0xFFF98324, 0xFFFFC15E, 0xFFFF9A3C),
    YELLOW(0xFFFAD321, 0xFFFFF38A, 0xFFFFE047),
    EMERALD(0xFF30CF8E, 0xFF8BF3C4, 0xFF4BE3A4),
    CORAL(0xFFFB5C79, 0xFFFFA1B3, 0xFFFF758F),
    SKY(0xFF35BDF5, 0xFF97E2FF, 0xFF59CEFF)
}

enum class DragEnd { HEAD, TAIL }

enum class BlockedReason {
    INVALID_CELL, NOT_ADJACENT, WALL, OCCUPIED, WRONG_HOLE, TAIL_ON_HOLE, ALREADY_ESCAPED
}

data class CellCoord(val r: Int, val c: Int) {
    fun manhattan(other: CellCoord): Int =
        kotlin.math.abs(r - other.r) + kotlin.math.abs(c - other.c)
}

/**
 * Dinding selalu dinormalisasi agar WallEdge(A, B) == WallEdge(B, A).
 */
data class WallEdge private constructor(val a: CellCoord, val b: CellCoord) {
    companion object {
        fun of(r1: Int, c1: Int, r2: Int, c2: Int): WallEdge {
            val p1 = CellCoord(r1, c1)
            val p2 = CellCoord(r2, c2)
            return if (r1 < r2 || (r1 == r2 && c1 < c2)) WallEdge(p1, p2) else WallEdge(p2, p1)
        }
    }
}

data class HoleDef(val id: String, val color: GeckoColor, val coord: CellCoord)
data class HoleState(val id: String, val color: GeckoColor, val coord: CellCoord, val sealed: Boolean = false)

/** segments[0] = HEAD, segments.last() = TAIL */
data class GeckoDef(val id: String, val color: GeckoColor, val segments: List<CellCoord>)
